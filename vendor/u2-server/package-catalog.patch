@@ -0,0 +1,47 @@
+package com.wetest.uia2.stub;
+
+import android.content.Intent;
+import android.content.pm.ApplicationInfo;
+import android.content.pm.PackageManager;
+import android.content.pm.ResolveInfo;
+import org.json.JSONArray;
+import org.json.JSONObject;
+import java.util.Map;
+import java.util.TreeMap;
+import uiautomator.InstrumentShellWrapper;
+
+/** Maxa-owned read-only package queries using the existing shell system context.
+ * No APK, instrumentation connection, or mobilecli code is used. */
+final class PackageCatalog {
+    private PackageCatalog() { }
+
+    private static JSONObject describe(PackageManager pm, ApplicationInfo info) throws Exception {
+        CharSequence label = info.loadLabel(pm);
+        if (label == null || label.length() == 0) {
+            throw new IllegalStateException("Package display label unavailable: " + info.packageName);
+        }
+        JSONObject app = new JSONObject();
+        app.put("packageName", info.packageName);
+        app.put("name", label.toString());
+        return app;
+    }
+
+    static String read(String packageName) throws Exception {
+        PackageManager pm = InstrumentShellWrapper.getInstance().getTargetContext().getPackageManager();
+        if (packageName != null) {
+            if (!packageName.matches("[A-Za-z0-9_]+(\\.[A-Za-z0-9_]+)*")) {
+                throw new IllegalArgumentException("Invalid package name");
+            }
+            return describe(pm, pm.getApplicationInfo(packageName, 0)).toString();
+        }
+        Intent launcher = new Intent(Intent.ACTION_MAIN).addCategory(Intent.CATEGORY_LAUNCHER);
+        Map<String, ApplicationInfo> apps = new TreeMap<>();
+        for (ResolveInfo activity : pm.queryIntentActivities(launcher, 0)) {
+            ApplicationInfo app = activity.activityInfo.applicationInfo;
+            apps.put(app.packageName, app);
+        }
+        JSONArray result = new JSONArray();
+        for (ApplicationInfo app : apps.values()) { result.put(describe(pm, app)); }
+        return result.toString();
+    }
+}
