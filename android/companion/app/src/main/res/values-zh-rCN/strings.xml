    <string name="termux_installed">Termux 已安装</string>
    <string name="termux_missing">未安装 Termux</string>
    <string name="get_termux_fdroid">Termux · F-Droid</string>
    <string name="get_termux_github">Termux · GitHub</string>
    <string name="step_agent">在 Termux 中安装 Agent</string>
    <string name="agent_desc">复制命令，在 Termux 的普通命令行中粘贴并回车。命令会校验安装脚本和 Agent，离线安装，与本应用链接并启动 Agent。再次执行可更新或修复。</string>
    <string name="payload_missing">此 APK 不含 Agent 载荷（占位构建），无法安装。</string>
    <string name="start_service">启动本机服务</string>
    <string name="copy_install">复制安装命令</string>
    <string name="copied_install">已作为敏感内容复制，请只粘贴到 Termux 的普通命令行中。</string>
    <string name="regenerate">重新生成链接</string>
    <string name="unlink">解除链接</string>
    <string name="regenerate_confirm">当前链接密钥会立即失效，需要在 Termux 中执行新的安装命令重新链接。</string>
    <string name="unlink_confirm">解除后，Termux 中的 Agent 将无法使用本应用，直到重新链接。</string>
    <string name="step_capabilities">能力</string>
    <string name="capabilities_desc">每项能力默认关闭。开启时会跳转到对应的系统页面，请在那里手动授权。</string>
    <string name="cap_ui">界面自动化</string>
    <string name="cap_ui_desc">读取界面元素、点击、滑动、输入文字和截图。需要开启无障碍服务。远程控制期间保持亮屏，最后一次操作 10 分钟后恢复。</string>
    <string name="cap_recording">录屏</string>
    <string name="cap_recording_desc">每次录制都需要你在本机确认。</string>
    <string name="cap_install">安装与卸载应用</string>
    <string name="cap_install_desc">需要“安装未知应用”权限，每次安装或卸载都需要你确认。</string>
    <string name="cap_orientation">屏幕方向</string>
    <string name="cap_orientation_desc">需要“修改系统设置”权限。</string>
    <string name="cap_clipboard">剪贴板</string>
    <string name="cap_clipboard_desc">读取时会短暂切换到本应用。</string>
    <string name="cap_usage">应用使用记录</string>
    <string name="cap_usage_desc">供 maxa-device android usage 使用，需要“使用情况访问”权限。</string>
    <string name="grant">去授权</string>
    <string name="restricted_settings">允许受限设置</string>
    <string name="restricted_hint">如果无障碍开关是灰色的，请先在“应用信息”右上角菜单中选择“允许受限设置”（Android 13 及以上的侧载应用）。</string>
    <string name="step_pair">与 Maxa 配对</string>
    <string name="pair_desc">在 Termux 中开启模块，再从 Maxa 发起配对，然后在 Termux 中核对验证码并批准。</string>
    <string name="pair_address">Maxa 中的手动地址</string>
    <string name="pair_address_unknown">未找到 Wi-Fi IPv4 地址</string>
    <string name="step_background">保持在线</string>
    <string name="background_desc">以下均为可选，由你决定：让 Termux 保持唤醒，为 Termux 关闭电池优化，并用 Termux:Boot 或 termux-services 自动启动 Agent（已安装 termux-services 时安装脚本会注册托管服务）。系统仍可能停止它；部分 Android 12 及以上设备还需要在开发者选项中解除子进程限制。实测的 HyperOS 平板上，只有 Termux 使用其 UID 时，将其省电策略设为“无限制”即可。如果另装 Termux:API 后仍冻结，可把 Termux 保持在小窗或分屏中；也可自行经 ADB 将 com.termux.api 追加到 MILLET_NO_RESTRICT_APP，保留已有条目。</string>
