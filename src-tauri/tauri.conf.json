{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Maxa Device",
  "version": "0.1.0",
  "identifier": "ai.maxa.device",
  "build": { "beforeDevCommand": "npm run dev", "devUrl": "http://127.0.0.1:1420", "beforeBuildCommand": "npm run build", "frontendDist": "../dist" },
  "app": {
    "windows": [{ "label": "main", "title": "Maxa Device", "width": 1120, "height": 780, "minWidth": 800, "minHeight": 600 }],
    "security": { "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost", "capabilities": [{ "identifier": "main", "windows": ["main"], "permissions": ["core:default"] }] }
  },
  "bundle": { "active": true, "targets": ["nsis"], "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"], "resources": { "../components.json": "components.json", "../packs/": "packs/", "../licenses/": "licenses/" } }
}
